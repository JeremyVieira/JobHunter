# JobHunterAI Environment Configuration Template
# Copy this file to .env and adjust your configuration values as needed:
# cp .env.example .env

# User Profile & Sensitive Contact Information
USER_NAME="Your Name"
USER_LOCATION="Montreal, QC"
USER_EMAIL="your.email@example.com"
USER_PHONE="(514) 000-0000"
USER_GITHUB="https://github.com/yourusername"
USER_DEGREE="Your degree or relevant education"
USER_EXPERIENCE_YEARS=1
USER_EXPERIENCE_SUMMARY="Briefly describe your relevant experience."
USER_NEAR_DOWNTOWN_MONTREAL=false

# JobSpy search queries and location. Search terms drive collection.
JOB_SEARCH_TERMS="Business Analyst, Data Analyst, Operations Analyst, Project Coordinator"
JOB_SEARCH_LOCATION="Montreal, QC"
JOBSPY_SITES="indeed,linkedin,zip_recruiter,glassdoor,google"

# Comma-separated profile titles and keywords for scoring/filtering.
USER_TARGET_ROLES="Business Analyst, Data Analyst, Operations Analyst, Project Coordinator"
USER_PRIORITY_TARGET_ROLES="Business Analyst, Operations Analyst"
USER_KEYWORDS="Excel, SQL, reporting, requirements gathering, project coordination"

# Daily Scheduled Collection Settings
JOBHUNTER_COLLECTION_HOUR=8
JOBHUNTER_COLLECTION_MINUTE=0

# Streamlit Dashboard Port
JOBHUNTER_DASHBOARD_PORT=8501

# Optional proxy settings for supported job-board requests. Use only services
# and configurations you are authorized to use; never commit proxy credentials.
# e.g. JOBSPY_PROXIES="http://user:pass@proxy1.example.com:8080,http://user:pass@proxy2.example.com:8080"
JOBSPY_PROXIES=

# Optional API Keys & Integrations
OPENAI_API_KEY=
